rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return signed() && role() == 'admin'; }
    function staff() { return signed() && role() in ['admin','calendarAdmin','editor']; }
    function active() { return signed() && role() in ['admin','calendarAdmin','editor','viewer']; }

    match /users/{uid} {
      allow read: if signed() && (request.auth.uid == uid || isAdmin());
      allow create: if signed() && request.auth.uid == uid && request.resource.data.role == 'pending';
      allow update: if isAdmin();
    }
    match /usernames/{name} {
      allow get: if true;
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
    }
    match /calendars/{id} {
      allow get: if true;               // necesario para el enlace público de reservas
      allow list: if active();
      allow create, update, delete: if isAdmin();
    }
    match /calendarMembers/{id} {
      allow read: if signed();
      allow write: if isAdmin();
    }
    match /interviewers/{id} {
      allow read: if active();
      allow write: if isAdmin();
    }
    match /appointments/{id} {
      allow create: if (request.resource.data.source == 'public' && request.resource.data.status == 'pending') || staff();
      allow read: if active();
      allow update, delete: if staff();
    }
    match /slots/{id} {                 // evita reservas dobles (id determinista)
      allow get, list: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if staff();
    }
  }
}
